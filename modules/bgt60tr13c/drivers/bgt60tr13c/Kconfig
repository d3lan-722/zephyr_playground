# Create a new option in menuconfig for enabling the BGT60TR13C RADAR driver
config BGT60TR13C
    bool "Enable Infineon BGT60TR13C RADAR Sensor Driver"
    default n # Disable by default
    depends on SPI && GPIO # Ensure SPI and GPIO support are available
    help
      Enable this option to include the Infineon BGT60TR13C 60GHz RADAR sensor driver in the build.
      This driver provides support for the BGT60TR13C RADAR sensor which can detect motion,
      presence, and range measurements.

if BGT60TR13C

config BGT60TR13C_INIT_PRIORITY
    int "BGT60TR13C init priority"
    default 90
    help
      Device driver init priority. Must run after CONFIG_SPI_INIT_PRIORITY
      and after the GPIO controllers used for reset-gpios and irq-gpios.
      Lower numbers init earlier.

endif # BGT60TR13C