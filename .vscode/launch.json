{
	// PSE84 debug configurations.
	//
	// Prerequisites:
	//   1. Board wired via KitProg3 (SWD).
	//   2. Toolchain at /usr/local/zephyr-sdk-1.0.1
	//   3. OpenOCD at /usr/local/openocd
	//   4. Cortex-Debug extension installed in VS Code.
	//
	// Symbol loading:
	//   Each CM33 config loads both the NS zephyr.elf AND the tfm_s.elf
	//   via add-symbol-file so a fault taken on the S side (e.g. the
	//   BusFault_Handler in platform/ext/common/faults.c) resolves in
	//   the source view. CONFIG_TFM_HALT_ON_CORE_PANIC=ON is passed to
	//   the TF-M build (see cm33_ns/CMakeLists.txt) so the S side spins
	//   in tfm_core_panic() instead of NVIC_SystemReset — that lets you
	//   attach with "02-pse84 CM33 (attach)" after the fault and inspect
	//   the exception frame stashed by EXCEPTION_INFO().
	"version": "0.2.0",
	"configurations": [
		{
			// Flash both slots (CM55 hex then CM33 merged TF-M+NS hex),
			// halt CM33 at reset, run to main. Use after a fresh build.
			"name": "02-pse84 CM33 (flash + debug)",
			"type": "cortex-debug",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm33_ns/build/zephyr/zephyr.elf",
			"armToolchainPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin",
			"gdbPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
			"objdumpPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump",
			"servertype": "openocd",
			"serverpath": "/usr/local/openocd/bin/openocd",
			"searchDir": [
				"${workspaceFolder}",
				"/usr/local/openocd/scripts"
			],
			"configFiles": [
				"${workspaceFolder}/util/openocd/pse84/openocd.tcl"
			],
			"preLaunchCommands": [
				"add-symbol-file ${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm33_ns/build/tfm/bin/tfm_s.elf",
				"add-symbol-file ${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm55/build/zephyr/zephyr.elf"
			],
			"overrideLaunchCommands": [
				"set mem inaccessible-by-default off",
				"-enable-pretty-printing",
				"set remotetimeout 90",
				// Program CM55 first, then the merged TF-M-S + CM33-NS
				// image — matches run.sh flash order.
				"monitor flash write_image erase {${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm55/build/zephyr/zephyr.hex}",
				"monitor flash write_image erase {${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm33_ns/build/zephyr/tfm_merged.hex}",
				"monitor reset init",
				"monitor reset_halt cm33"
			],
			"overrideRestartCommands": [
				"monitor reset_halt cm33"
			],
			"postRestartSessionCommands": [],
			"numberOfProcessors": 2,
			"targetProcessor": 0,
			"svdFile": "${workspaceFolder}/util/openocd/pse84/pse84.svd",
			"breakAfterReset": true,
			"runToEntryPoint": "main",
			"showDevDebugOutput": "none",
			"presentation": {
				"hidden": false,
				"group": "02_pse84_tfm_m33_m55_pm"
			}
		},
		{
			// Attach to a running or already-halted CM33 without
			// touching flash. Use this after the direct-PDL experiment
			// crashes and CONFIG_TFM_HALT_ON_CORE_PANIC=ON has left
			// the S side spinning in tfm_core_panic — attaching should
			// land you inside the fault handler with the exception
			// frame still on the stack.
			"name": "02-pse84 CM33 (attach)",
			"type": "cortex-debug",
			"request": "attach",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm33_ns/build/zephyr/zephyr.elf",
			"armToolchainPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin",
			"gdbPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
			"objdumpPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump",
			"servertype": "openocd",
			"serverpath": "/usr/local/openocd/bin/openocd",
			"searchDir": [
				"${workspaceFolder}",
				"/usr/local/openocd/scripts"
			],
			"configFiles": [
				"${workspaceFolder}/util/openocd/pse84/openocd.tcl"
			],
			"openOCDPreConfigLaunchCommands": [
				// Non-invasive attach: don't reset, don't reload flash.
				"set ENABLE_ACQUIRE 0"
			],
			"overrideAttachCommands": [
				"set mem inaccessible-by-default off",
				"-enable-pretty-printing",
				"set remotetimeout 90",
				"monitor halt",
				"add-symbol-file ${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm33_ns/build/tfm/bin/tfm_s.elf",
				"add-symbol-file ${workspaceFolder}/apps/02_pse84_tfm_m33_m55_pm/cm55/build/zephyr/zephyr.elf"
			],
			"postAttachCommands": [
				// TF-M's fault handlers capture CFSR/HFSR/BFAR/SFSR
				// into the static struct exception_info and then
				// clear the write-1-to-clear bits. So the LIVE regs
				// read as zero after a fault. Look at the struct
				// instead — that's the real forensics.
				//
				// See platform/ext/common/exception_info.c and
				// its dump_exception_info() for the field meanings.
				"echo === Captured fault info (struct exception_info in tfm_s) ===\\n",
				"print /x exception_info",
				"echo === Where is the CPU now? PC / xPSR / MSP / PSP / LR ===\\n",
				"monitor reg pc",
				"monitor reg xpsr",
				"monitor reg msp",
				"monitor reg psp",
				"monitor reg lr",
				"echo === GDB backtrace (S side) ===\\n",
				"backtrace 15",
				"echo === Exception frame words at MSP (raw) ===\\n",
				"x/16wx $msp",
				"echo === Live HW fault regs (usually zero — TF-M cleared them; kept as sanity) ===\\n",
				"echo === Secure bank: CFSR HFSR DFSR MMFAR BFAR ===\\n",
				"monitor mdw 0xE000ED28 5",
				"echo === Non-Secure alias: CFSR HFSR DFSR MMFAR BFAR ===\\n",
				"monitor mdw 0xE002ED28 5",
				"echo === Secure SFSR SFAR ===\\n",
				"monitor mdw 0xE000EDE4 2",
				"echo === Disassemble around PC (16 instructions) ===\\n",
				"x/16i $pc - 16"
			],
			"numberOfProcessors": 2,
			"targetProcessor": 0,
			"svdFile": "${workspaceFolder}/util/openocd/pse84/pse84.svd",
			"showDevDebugOutput": "none",
			"presentation": {
				"hidden": false,
				"group": "02_pse84_tfm_m33_m55_pm"
			}
		},
