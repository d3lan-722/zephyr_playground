		{
			// Fallback for when "05-pse84 CM33 (attach)" fails with
			// `stalled AP operation, issuing ABORT` /
			// `[cat1d.cm33] Examination failed`. That happens when the
			// target CPU is in a state where the debug AP is
			// unreachable — e.g. ULP mode dropped the debug clock
			// below what SWD can talk to, or the transition hung with
			// the CPU in some sleep-adjacent state.
			//
			// This variant flips ENABLE_ACQUIRE=1 so the openocd.tcl
			// runs `init` + `reset init` + `adapter speed 12000` at
			// attach, which resets the target hard. That is DESTRUCTIVE
			// to the hung state — you lose whatever PC/registers the
			// hang left behind. Use it only to regain shell access
			// after a hang, then reproduce with a breakpoint set on
			// the entry path (e.g. `b ifx_user_srf_op_enter_ulp_impl_s`
			// or `b Cy_SysPm_SystemEnterUlp`) via the "flash + debug"
			// config to catch WHERE it hangs before the CPU becomes
			// undebuggable.
			"name": "05-pse84 CM33 (attach with reset — destructive)",
			"type": "cortex-debug",
			"request": "attach",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/apps/05_pse84_tfm_m33_m55_shell_ulp_lp_hp/cm33_ns/build/zephyr/zephyr.elf",
			"armToolchainPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin",
			"gdbPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
			"objdumpPath": "/usr/local/zephyr-sdk-1.0.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump",
			"servertype": "openocd",
			"serverpath": "/usr/local/openocd/bin/openocd",
			"searchDir": [
				"${workspaceFolder}",
				"/usr/local/openocd/scripts"
			],
			"configFiles": [
				"${workspaceFolder}/util/openocd/pse84/openocd.tcl"
			],
			"openOCDPreConfigLaunchCommands": [
				// ENABLE_ACQUIRE=1 -> openocd.tcl runs init +
				// reset init + adapter speed 12000. This resets
				// the chip, so any hang state is LOST. See
				// util/openocd/pse84/openocd.tcl for the exact
				// sequence.
				"set ENABLE_ACQUIRE 1"
			],
			"overrideAttachCommands": [
				"set mem inaccessible-by-default off",
				"-enable-pretty-printing",
				"set remotetimeout 90",
				"monitor halt",
				"add-symbol-file ${workspaceFolder}/apps/05_pse84_tfm_m33_m55_shell_ulp_lp_hp/cm33_ns/build/tfm/bin/tfm_s.elf",
				"add-symbol-file ${workspaceFolder}/apps/05_pse84_tfm_m33_m55_shell_ulp_lp_hp/cm55/build/zephyr/zephyr.elf"
			],
			"numberOfProcessors": 2,
			"targetProcessor": 0,
			"svdFile": "${workspaceFolder}/util/openocd/pse84/pse84.svd",
			"showDevDebugOutput": "none",
			"presentation": {
				"hidden": false,
				"group": "05_pse84_tfm_m33_m55_shell_ulp_lp_hp"
			}
		},
		{
			// Flash both slots (CM55 hex then CM33 merged TF-M+NS hex),
