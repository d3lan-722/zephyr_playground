			// hang lands you inside the fault handler with the
			// exception frame still captured in `exception_info`.
			//
			// Useful breakpoints for debugging the pm transition:
			//   b z_pm_op_switch_active_mode
			//   b trans_down
			//   b trans_up
			//   b core_buck_only_enter
			//   b Cy_SysPm_SystemEnterLp
			//   b Cy_SysPm_SystemEnterUlp
			//   b Cy_SysPm_SetTrimRamCtl
			//   b step_transition   (NS side)
			"name": "07-pse84 CM33 (attach)",
			"type": "cortex-debug",
			"request": "attach",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/apps/07_pse84_tfm_m33_mm55_power_shell/cm33_ns/build/zephyr/zephyr.elf",
