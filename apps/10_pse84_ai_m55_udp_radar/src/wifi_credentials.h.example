/*
 * Wi-Fi credentials template.
 *
 * Copy this file to `wifi_credentials.h` in the same directory and edit
 * with your network SSID and pre-shared key.  The real file
 * (`wifi_credentials.h`) is git-ignored so private credentials never
 * enter the repository.
 *
 *   cp src/wifi_credentials.h.example src/wifi_credentials.h
 *   $EDITOR src/wifi_credentials.h
 */

#ifndef APP_WIFI_CREDENTIALS_H_
#define APP_WIFI_CREDENTIALS_H_

#define WIFI_SSID "YOUR_SSID_HERE"
#define WIFI_PSK  "YOUR_PSK_HERE"

#endif /* APP_WIFI_CREDENTIALS_H_ */
