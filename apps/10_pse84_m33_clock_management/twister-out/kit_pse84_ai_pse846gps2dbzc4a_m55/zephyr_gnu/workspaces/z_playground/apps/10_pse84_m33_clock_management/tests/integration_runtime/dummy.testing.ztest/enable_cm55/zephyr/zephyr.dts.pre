/ {
 model = "kit_pse84_ai";
 compatible = "kit_pse84_ai";

 aliases {
  led0 = &led_0;
  led1 = &led_1;
  led2 = &led_red;
 };

 chosen {
  zephyr,flash = &flash0_s;
  zephyr,sram = &m33s_data;
  zephyr,code-partition = &m33s_xip;
  zephyr,console = &uart2;
  zephyr,shell-uart = &uart2;
  zephyr,bt-hci = &bt_hci_uart;
  zephyr,entropy = &mxcrypto_trng;
 };
};

&mcwdt0 {
 status = "okay";
};
