  pinctrl-0 = <&p1_0_smif0_data0 &p1_1_smif0_data1
        &p1_2_smif0_data2 &p1_3_smif0_data3
        &p2_0_smif0_select1>;
  pinctrl-names = "default";





  flash0: flash0@8000000 {
   compatible = "soc-nv-flash", "infineon,s25hs512t";
   reg = <0x08000000 (((64) * 1024) * 1024)>;
   #address-cells = <1>;
   #size-cells = <1>;
   ranges = <0x0 0x08000000 (((64) * 1024) * 1024)>;
   write-block-size = <16>;
   erase-block-size = <((256) * 1024)>;

   partitions {
    #address-cells = <1>;
    #size-cells = <1>;
