     reg = <0 (((1) * 1024) * 1024)>;
    };

    m33_xip: m33_xip@340400 {
     compatible = "zephyr,mapped-partition";
     label = "m33-xip";
     reg = <0x340400 (((2) * 1024) * 1024)>;
    };
   };
  };
