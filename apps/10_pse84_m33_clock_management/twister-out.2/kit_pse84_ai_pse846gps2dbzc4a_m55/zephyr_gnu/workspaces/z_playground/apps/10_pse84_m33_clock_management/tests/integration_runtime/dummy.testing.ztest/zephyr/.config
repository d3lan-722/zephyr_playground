SB_CONFIG_BOARD="kit_pse84_ai"
SB_CONFIG_BOARD_REVISION=""
SB_CONFIG_BOARD_KIT_PSE84_AI=y
SB_CONFIG_BOARD_KIT_PSE84_AI_PSE846GPS2DBZC4A_M55=y
SB_CONFIG_BOARD_QUALIFIERS="pse846gps2dbzc4a/m55"
SB_CONFIG_SOC="pse846gps2dbzc4a"
SB_CONFIG_SOC_SERIES="pse84"
SB_CONFIG_SOC_FAMILY="infineon_edge"
SB_CONFIG_SOC_FAMILY_INFINEON_EDGE=y
SB_CONFIG_SOC_SERIES_PSE84=y
SB_CONFIG_SOC_SERIES_PSE84_M55=y
SB_CONFIG_SOC_DIE_PSE8XXGP=y
SB_CONFIG_SOC_PACKAGE_PSE84_BGA_220=y
SB_CONFIG_SOC_PSE846GPS2DBZC4A=y
SB_CONFIG_SOC_PSE846GPS2DBZC4A_M55=y

#
# Sysbuild image configuration
#
SB_CONFIG_RA_SECOND_CORE_LAUNCHER_NAME="cm85"

#
# Modules
#

#
# Available modules.
#
SB_CONFIG_ZEPHYR_CMSIS_MODULE=y
SB_CONFIG_ZEPHYR_CMSIS_6_MODULE=y
SB_CONFIG_ZEPHYR_HAL_INFINEON_MODULE=y
SB_CONFIG_ZEPHYR_MBEDTLS_MODULE=y
SB_CONFIG_ZEPHYR_MCUBOOT_MODULE=y
SB_CONFIG_ZEPHYR_PICOLIBC_MODULE=y
SB_CONFIG_ZEPHYR_TF_M_TESTS_MODULE=y
SB_CONFIG_ZEPHYR_TF_PSA_CRYPTO_MODULE=y
SB_CONFIG_ZEPHYR_TRUSTED_FIRMWARE_M_MODULE=y

#
# Unavailable modules, please install those via the project manifest.
#
# end of Modules

# SB_CONFIG_WARN_EXPERIMENTAL is not set
SB_CONFIG_WARN_DEPRECATED=y
SB_CONFIG_SUPPORT_BOOTLOADER=y
SB_CONFIG_SUPPORT_BOOTLOADER_MCUBOOT_ZEPHYR=y
SB_CONFIG_BOOTLOADER_NONE=y
# SB_CONFIG_BOOTLOADER_MCUBOOT is not set
SB_CONFIG_SUPPORT_FIRMWARE_LOADER_SMP_SVR=y

#
# Build options
#
SB_CONFIG_COMPILER_WARNINGS_AS_ERRORS=y
# SB_CONFIG_MERGED_HEX_FILES is not set
# end of Build options
