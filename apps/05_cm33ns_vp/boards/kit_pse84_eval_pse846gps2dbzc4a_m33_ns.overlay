/*
 * Minimal DTS overlay: keep only what is required to boot and print
 * "Hello World" on the console UART (uart2 / scb2).
 *
 * Kept enabled from the board files:
 *   - scb2 (uart2)              -> zephyr,console / zephyr,shell-uart
 *   - peri0_group1_16bit_1      -> uart2 clock divider
 *   - flash_controller / rram0  -> code / storage (required for boot)
 *   - system clocks             -> untouched (SoC default)
 *
 * Everything else that the board enables at boot is turned off here.
 */

/ {
	/* Disable LED / button containers so they do not pull in GPIO ports.
	 * The nodes are kept (not deleted) so that aliases referencing their
	 * child labels (led0..led2, sw0) remain valid.
	 */
	leds      { status = "disabled"; };
	gpio_keys { status = "disabled"; };
};

/* --- GPIO ports (none needed for bare UART console) --------------------- */
&gpio_prt0  { status = "disabled"; };
&gpio_prt2  { status = "disabled"; };
&gpio_prt6  { status = "disabled"; };
&gpio_prt7  { status = "disabled"; };
&gpio_prt8  { status = "disabled"; };
&gpio_prt10 { status = "disabled"; };
&gpio_prt11 { status = "disabled"; };
&gpio_prt13 { status = "disabled"; };
&gpio_prt14 { status = "disabled"; };
&gpio_prt16 { status = "disabled"; };
&gpio_prt17 { status = "disabled"; };

/* --- SCBs / serial we do not use --------------------------------------- */
&scb0 { status = "disabled"; };   /* i2c0 + bmi270 */
&scb4 { status = "disabled"; };   /* uart4 / bt_hci_uart / cyw55513 */

/* --- Timers / watchdog ------------------------------------------------- */
&watchdog0 { status = "disabled"; };
&mcwdt0    { status = "disabled"; };

/* --- Storage / connectivity ------------------------------------------- */
&sdhc0  { status = "disabled"; };  /* SDIO + airoc-wifi */
&usbhs  { status = "disabled"; };

/* --- Peripheral clock dividers only used by disabled peripherals ------ */
&peri0_group1_16bit_3   { status = "disabled"; };  /* i2c0  */
&peri0_group1_16_5bit_0 { status = "disabled"; };  /* uart4 */
&peri1_group2_8bit_0    { status = "disabled"; };  /* sdhc0 */

/* --- Virtual-platform PMU (SystemC/TLM model) --------------------------
 * Generic Power Modeling Unit hooked to the M33-NS bus in the SystemC
 * model. Base address is chosen inside the free peripheral window
 * 0x40000000 .. 0x48000000; the model accepts any base in that range.
 */
/ {
	soc {
		pmu0: pmu@40100000 {
			compatible = "infineon,pmu-dvfs";
			reg = <0x40100000 0x10000>;
			status = "okay";

			num-pstates = <4>;
			transition-timeout-us = <1000>;

			/* (freq-MHz, voltage-mV) pairs, one per P-state.
			 * Ordered low-power (P0) to high-performance (P3).
			 */
			pstate-table = <
				100   700
				200   800
				400   900
				800  1000
			>;

			init-enable;
			init-pstate = <0>;
		};
	};

	aliases {
		pmu0 = &pmu0;
	};
};
