 * SPDX-License-Identifier: Apache-2.0
 *
 * Minimal DT overlay for apps/06_pse84_m33_s_shell_ulp_lp_hp.
 *
 * Kept enabled (from the board common.dtsi / kit_pse84_eval_m33.dts):
 *   scb2 (uart2)              -> zephyr,console + zephyr,shell-uart
 *   peri0_group1_16bit_1      -> scb2 peripheral clock divider
 *   gpio_prt16                -> RGB LEDs (led0..led2 on P16.5-7)
 *   gpio_prt3                 -> pm_busy scope trigger on P3.1
 *   flash_controller / rram0  -> code storage (--snippet rram redirects
 *                                zephyr,flash here)
 *
 * Clock-tree baseline (see PLAN_dual_dvfs.md for full rationale)
 * ---------------------------------------------------------------
 * DPLL_LP0 is retuned to 200 MHz (from the board default 400 MHz)
 * and CLK_HF0 is set to divide-by-1, so:
 *
 *   DPLL_LP0 = 200 MHz
 *     |-- CLK_HF0  (/1)  = 200 MHz  -> CM33 core, AN237976 HP max
 *     `-- CLK_HF10 (/4)  =  50 MHz  -> SCB2 peripheral clock
 *
 * Reasons for this baseline:
 *   1. CM33 lands at exactly the AN237976 HP spec ceiling from boot,
 *      no runtime action needed.
 *   2. The maximum DPLL frequency ever seen at runtime is 200 MHz,
 *      safely inside DPLL_LP's 10-500 MHz spec at every voltage --
 *      the 400 MHz baseline previously flirted with the ULP-voltage
 *      lock hazard whenever the PLL-retune path had to reprogram
 *      it back up.
 *   3. Both DVFS approaches (PLL-retune and divider-only, see
 *      PLAN_dual_dvfs.md) share this same baseline so a switch
 *      between them is a code-only change.
 */

#include <zephyr/dt-bindings/clock/ifx_clock_source_common.h>

/ {
	/* Disable the gpio-keys container so the user button (P8.3)
	 * doesn't drag in gpio_prt8. The child node stays defined so
	 * DT_ALIAS(sw0) remains resolvable (evaluates disabled). */
	gpio_keys { status = "disabled"; };

	/* PM-transition scope trigger. P3.1 is driven high by the shell
	 * command layer while a mode change is in progress and low
	 * again once the transition (including SCB retune + clock
	 * probe) has completed. Wire a scope / logic-analyzer probe
	 * here to correlate current-draw waveforms with the actual
	 * software transition window. */
	pm_signals {
		compatible = "gpio-leds";
		pm_busy: pm_busy {
			label = "PM_BUSY";
			gpios = <&gpio_prt3 1 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		pm-busy = &pm_busy;
	};
};

/* Enable gpio_prt3 -- disabled at the SoC-dtsi level, but we need
 * it to drive the pm_busy scope trigger on P3.1 (see pm_signals
 * above). */
&gpio_prt3 { status = "okay"; };

/* ------------------------------------------------------------------
 * DPLL_LP0 -- retune the board default from 400 MHz to 200 MHz.
 *
 * Formula: output = input * feedback-div / (reference-div * output-div)
 * Input on this board is IHO = 50 MHz. Board default (400 MHz) uses
 * FB=56, REF=7, OUT=1 -> 50 * 56 / (7 * 1) = 400. Halving FB to 28
 * gives 50 * 28 / (7 * 1) = 200 MHz. Reference-div stays 7 to keep
 * the same phase-noise / jitter profile the board vendor selected.
 * ------------------------------------------------------------------ */
&dpll_lp0 {
	clock-frequency = <200000000>;
	feedback-div = <28>;
	reference-div = <7>;
	output-div = <1>;
	fraction-div = <0>;
};

&clk_hf0 {
	/* /1: DPLL_LP0 (200 MHz) -> CLK_HF0 200 MHz.
	 * Matches AN237976 CM33 HP frequency spec. The board default
	 * is /2 (was correct when DPLL was 400 MHz); we override to /1
	 * now that DPLL is at 200 MHz so the same baseline works for
	 * both DVFS approaches (see PLAN_dual_dvfs.md). */
	clock-div = <IFX_CLK_HF_NO_DIVIDE>;
};

/* ------------------------------------------------------------------
 * GPIO ports: keep only gpio_prt16 (RGB LEDs) and gpio_prt3 (see
 * the pm_signals node above -- P3.1 is the pm_busy scope trigger).
 * SCB2 pins (P6.5/P6.7) are routed by the pinctrl subsystem and do
 * NOT require the gpio_prt6 node to be enabled -- the pinctrl
 * driver programs HSIOM directly.
 * ------------------------------------------------------------------ */
&gpio_prt0  { status = "disabled"; };
&gpio_prt2  { status = "disabled"; };
&gpio_prt6  { status = "disabled"; };
&gpio_prt7  { status = "disabled"; };
&gpio_prt8  { status = "disabled"; };
&gpio_prt10 { status = "disabled"; };
&gpio_prt11 { status = "disabled"; };
&gpio_prt13 { status = "disabled"; };
&gpio_prt14 { status = "disabled"; };
&gpio_prt17 { status = "disabled"; };

/* ------------------------------------------------------------------
 * SCBs we don't use.
 * ------------------------------------------------------------------ */
&scb0 { status = "disabled"; };   /* i2c0 + bmi270 accelerometer   */
&scb4 { status = "disabled"; };   /* uart4 + bt_hci_uart + cyw55513 */

/* Their peripheral clock dividers -- also unused. */
&peri0_group1_16bit_3   { status = "disabled"; };  /* scb0 clock */
&peri0_group1_16_5bit_0 { status = "disabled"; };  /* scb4 clock */

/* ------------------------------------------------------------------
 * Timers, watchdogs, storage, connectivity we don't use.
 * ------------------------------------------------------------------ */
&watchdog0 { status = "disabled"; };
&mcwdt0    { status = "disabled"; };
&sdhc0     { status = "disabled"; };   /* SDIO + airoc-wifi */
&usbhs     { status = "disabled"; };
